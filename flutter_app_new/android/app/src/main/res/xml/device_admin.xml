<?xml version="1.0" encoding="utf-8"?>
<!--
  GGC PARTENAIRE — politique Device Admin.
  Uniquement : force-lock (verrouillage écran) et limit-password.
  Aucune permission caméra n'est déclarée ici ni ailleurs dans le manifeste.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <limit-password />
    </uses-policies>
</device-admin>
